APP_NAME="{{ app_name }}"
APP_ENV={{ app_env }}
APP_KEY={{ vault_app_key }}
APP_DEBUG={{ app_debug | ternary('true', 'false') }}
APP_URL={{ app_url }}
APP_TIMEZONE={{ app_timezone }}

APP_LOCALE={{ app_locale }}
APP_FALLBACK_LOCALE={{ app_fallback_locale }}
APP_FAKER_LOCALE={{ app_faker_locale }}

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL={{ app_log_level }}

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{ app_db_name }}
DB_USERNAME={{ app_db_user }}
DB_PASSWORD="{{ vault_app_db_password }}"

SESSION_DRIVER=database
SESSION_LIFETIME={{ app_session_lifetime }}
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN={{ app_session_domain }}
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEDIA_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER={{ app_mailer }}
MAIL_SCHEME={{ app_mail_scheme }}
MAIL_HOST={{ app_mail_host }}
MAIL_PORT={{ app_mail_port }}
MAIL_USERNAME={{ app_mail_username }}
MAIL_PASSWORD="{{ vault_app_mail_password | default('') }}"
MAIL_FROM_ADDRESS="{{ app_mail_from_address }}"
MAIL_FROM_NAME="{{ app_mail_from_name }}"

FORMS_ADMIN_EMAIL={{ app_forms_admin_email }}
FORMS_QUEUE={{ app_forms_queue }}

SEO_ORG_NAME="{{ seo_org_name }}"
SEO_ORG_LOGO={{ seo_org_logo }}
SEO_ORG_PHONE="{{ seo_org_phone }}"
SEO_ORG_EMAIL="{{ seo_org_email }}"
SEO_ORG_COUNTRY={{ seo_org_country }}
SEO_ORG_CITY="{{ seo_org_city }}"
SEO_ORG_STREET="{{ seo_org_street }}"
SEO_ORG_SAME_AS="{{ seo_org_same_as }}"
