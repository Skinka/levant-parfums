[Unit]
Description={{ app_name }} Laravel queue worker
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_path }}
ExecStart=/usr/bin/php{{ php_version }} {{ app_path }}/artisan queue:work --sleep=3 --tries=3 --max-time=3600 --no-interaction
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
